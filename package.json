{
	"name": "crt-lens",
	"version": "1.0.0",
	"description": "Кнопки-плагины в меню объектов Freelens: терминал в доке, внешний терминал, SecureCRT, ссылки в браузер",
	"publisher": "@crt-lens/crt-lens",
	"renderer": "dist/renderer.js",
	"files": [
		"dist/renderer.js",
		"crt-lens.sample.yaml",
		"terminals.sample.yaml",
		"examples",
		"README.md"
	],
	"engines": {
		"node": ">=16",
		"freelens": "^1.0.0"
	},
	"keywords": [
		"freelens",
		"extension",
		"kubernetes",
		"shell",
		"securecrt",
		"terminal"
	],
	"scripts": {
		"build": "npm run clean && vite build",
		"clean": "rm -rf ./dist",
		"start": "vite build --watch",
		"smoke": "npm run build && node scripts/smoke.mjs",
		"test": "vitest run",
		"type:check": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"js-yaml": "^4.1.0"
	},
	"devDependencies": {
		"@freelensapp/core": "^1.10.3",
		"@freelensapp/extensions": "^1.10.3",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^22.10.2",
		"@types/react": "^17.0.83",
		"mobx": "^6.13.5",
		"mobx-react": "^7.6.0",
		"react": "^17.0.2",
		"typescript": "^5.7.2",
		"vite": "^6.0.7",
		"vitest": "^2.1.8"
	}
}
