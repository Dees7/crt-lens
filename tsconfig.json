{
  "compilerOptions": {
    // target — ES2022: esbuild в текущей vite про ES2024 ещё не знает и ругается
    // на каждый файл. lib при этом обязан быть ES2024 — типы mobx 6.15 ссылаются
    // на ReadonlySetLike, который появился только там. Что попадёт в бандл,
    // решает build.target в vite.config.mjs (там es2020, под Chromium 1.x).
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    // автоматический JSX-рантайм работает и на React 17: хост публикует
    // ReactJsxRuntime на глобале, а `react/jsx-runtime` появился в 17.0
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      // @freelensapp/extensions 1.10.3 на npm есть, но его d.ts — семь строк
      // реэкспорта из @freelensapp/core, а тот в `exports` поле `types` не
      // объявляет: без подсказки TS молча выдаёт `any` на весь API. Декларации
      // в пакете лежат, просто по нестандартному пути.
      "@freelensapp/core/renderer": [
        "./node_modules/@freelensapp/core/static/build/library/src/renderer/library.d.ts"
      ],
      "@freelensapp/core/main": [
        "./node_modules/@freelensapp/core/static/build/library/src/main/library.d.ts"
      ]
    }
  },
  "include": ["src/**/*", "types/**/*"]
}
